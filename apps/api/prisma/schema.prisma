// Схема Prisma для трекера расходов.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Nest компилируется в CommonJS, поэтому клиент генерируем в том же формате.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // В Prisma 7 `url` в схеме запрещён: для CLI он задаётся в prisma.config.ts,
  // а рантайм получает подключение через адаптер в PrismaClient.
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  isActive     Boolean   @default(true) // мягкая блокировка без удаления
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  color     String
  icon      String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@map("categories")
}

/// Направление движения денег.
enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

model Transaction {
  id     String          @id @default(uuid(7)) @db.Uuid
  // Деньги храним точно: Decimal, а не float.
  amount Decimal         @db.Decimal(12, 2)
  type   TransactionType

  description String?
  // Дата операции, задаётся пользователем — не путать с createdAt.
  date        DateTime

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Под основной запрос: транзакции пользователя за период, отсортированные по дате.
  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}
